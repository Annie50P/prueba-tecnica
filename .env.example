# Neo4j (solo necesario si se usa con Graphiti en Docker)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
GRAPHITI_URL=http://graphiti:8000

# ── Graphiti MCP Server (help.getzep.com/v3/graphiti/getting-started/mcp-server) ──
# Servidor MCP oficial que expone add_episode, search_nodes, search_facts, etc.
# Requiere OPENAI_API_KEY para el LLM interno que usa Graphiti al extraer entidades.
GRAPHITI_MCP_URL=http://graphiti-mcp:8000/mcp/
GRAPHITI_MCP_PORT=8020
MCP_MODEL_NAME=gpt-4o-mini
MCP_LLM_PROVIDER=openai
MCP_EMBEDDER_PROVIDER=openai
MCP_SEMAPHORE_LIMIT=10

# LLM — al menos uno requerido para el Chat IA
# Obtener gratis en: https://aistudio.google.com/apikey
# OPCIÓN RECOMENDADA — Groq: gratis, sin tarjeta, 14 400 req/día
# Registro: https://console.groq.com → API Keys → Create
GROQ_API_KEY=
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto = Groq > OpenAI > Gemini > Anthropic (primera key disponible)
LLM_PROVIDER=auto

# Puertos
API_PORT=8001
FRONTEND_PORT=3000
MCP_URL=http://localhost:8002

# ── Reglas de negocio (audit C4/C6) ──────────────────────────────
# Días de gracia para considerar una promesa como cumplida con un pago posterior.
PROMESA_GRACE_DAYS=3
# Cómo resolver `PromesaPago.cumplida` en las queries:
#   snapshot  → leer props.cumplida persistido por la ingesta (rápido, puede
#               quedar stale si llegan pagos entre ingestas).
#   dynamic   → compute-on-read: reconsidera si hay Pago dentro de grace_days
#               del mismo cliente. Elimina el problema de staleness; más queries.
PROMESA_CUMPLIDA_MODE=snapshot

# ── Backend del grafo (B1) ───────────────────────────────────────
# graphiti → GraphitiGraphRepository (default): accede a Neo4j a través de
#            graphiti-core. Graphiti gestiona la conexión y el knowledge graph.
#            API REST y MCP leen el mismo grafo — fuente única de verdad.
# neo4j    → Neo4jGraphRepository: driver neo4j directo (sin Graphiti).
# sqlite   → SqliteGraphRepository: fallback local offline.
GRAPH_BACKEND=graphiti

# Group ID de Graphiti para aislar el grafo de este proyecto.
GRAPHITI_GROUP_ID=prueba-tecnica

# ── Ingesta (audit C5) ───────────────────────────────────────────
# Emisión de aristas SIGUIENTE (cadena temporal). 0 = desactiva (timestamp
# index-based ordering cubre el caso a gran escala sin N-1 aristas por cliente).
CREATE_SIGUIENTE=1
